# =============================================================
# Content Repurposer — Environment Variables
# =============================================================
# Скопіюй цей файл у .env і заповни свої значення
# НІКОЛИ не комміть .env у git!
# =============================================================

# --- Gemini AI ---
# Отримай ключ на: https://aistudio.google.com/app/apikey
# (більше не використовується — AI замінено на Ollama)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Ollama (local AI) ---
# Для запуску в Docker — host.docker.internal вказує на твою машину.
# Для локального запуску backend без Docker постав http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-v4-flash:cloud

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
BACKEND_PORT=8000
# Секретний ключ для підпису токенів (генеруй: openssl rand -hex 32)
SECRET_KEY=change_me_generate_random_string

# Допустимі origins для CORS (через кому)
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
# Варіант 1: локальне сховище (для розробки)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/repurposer_jobs

# Варіант 2: S3 (для продакшену — розкоментуй і заповни)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# S3_BUCKET=content-repurposer

# TTL для тимчасових файлів (секунди, за замовчуванням 24 год)
FILE_TTL_SECONDS=86400

# --- Rate Limiting ---
RATE_LIMIT_PER_DAY=5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
